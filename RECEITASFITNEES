                        "Acrescente o scoop de whey protein do sabor escolhido.",
                        "Se for usar leite vegetal para mais cremosidade, adicione-o agora.",
                        "Se desejar mais doce, adicione seu adoçante preferido a gosto.",
                        "Feche bem a coqueteleira e agite vigorosamente por cerca de 30 segundos, ou até que o whey protein esteja completamente dissolvido e a mistura espumosa. Se estiver usando o liquidificador, bata por alguns segundos até ficar homogêneo.",
                        "Encha um copo grande com cubos de gelo.",
                        "Despeje cuidadosamente a mistura de café proteico sobre o gelo.",
                        "Se desejar, polvilhe um pouco de cacau em pó (se usou whey de chocolate) ou canela em pó (se usou whey de baunilha) por cima para decorar.",
                        "Mexa levemente com um canudo, se necessário, e sirva imediatamente."
                    ],
                    macros: { "Proteínas": 40, "Carboidratos": 30, "Gorduras": 30 },
                    imagePlaceholder: "☕"
                },
                bebida_sucha_maracuja: {
                    id: 'bebida_sucha_maracuja', categoryKey: 'bebida', categoryName: "Bebida Funcional", title: 'Suchá Calmante de Maracujá com Camomila',
                    explanation: 'Uma bebida que combina as propriedades calmantes e relaxantes do maracujá e da camomila. Perfeita para consumir à noite ou em momentos de estresse, ajudando a relaxar.',
                    ingredients: ["Polpa de 1 maracujá azedo maduro (com sementes)", "1 xícara (240ml) de chá de camomila forte, já preparado e frio", "1/2 xícara (120ml) de água filtrada (opcional, para diluir se preferir)", "Adoçante natural a gosto (mel, stevia, xilitol - opcional)", "Cubos de gelo a gosto", "Folhas de hortelã para decorar (opcional)"],
                    steps: [
                        "Prepare o chá de camomila: Ferva 1 xícara de água e adicione 1-2 sachês de chá de camomila (ou 1 colher de sopa de flores secas de camomila). Deixe em infusão por 5-10 minutos. Coe (se usou flores soltas) e deixe esfriar completamente. Para acelerar, pode levar à geladeira.",
                        "No copo do liquidificador, adicione a polpa do maracujá (com as sementes, que são comestíveis e ricas em fibras, mas se preferir um suco mais liso, pode bater e coar a polpa antes).",
                        "Acrescente o chá de camomila já frio ao liquidificador.",
                        "Se desejar uma bebida menos concentrada, adicione a 1/2 xícara de água filtrada.",
                        "Se for adoçar, adicione o adoçante de sua preferência a gosto.",
                        "Bata todos os ingredientes no liquidificador por cerca de 30 segundos a 1 minuto, apenas para misturar bem e triturar um pouco as sementes do maracujá (se as manteve).",
                        "Encha os copos com cubos de gelo.",
                        "Despeje o suchá sobre o gelo.",
                        "Decore com algumas folhas de hortelã fresca, se desejar.",
                        "Sirva imediatamente e desfrute desta bebida relaxante."
                    ],
                    macros: { "Proteínas": 2, "Carboidratos": 90, "Gorduras": 8 },
                    imagePlaceholder: "🌼"
                }
            }
        };

        const contentArea = document.getElementById('content-area');
        const navButtons = document.querySelectorAll('.nav-button');
        const saveEbookButton = document.getElementById('save-ebook-button');
        let currentChart = null;

        function formatRecipeForEbook(recipeData) {
            let text = `RECEITA: ${recipeData.title.toUpperCase()}\n`;
            text += `CATEGORIA: ${recipeData.categoryName}\n\n`;
            text += `DESCRIÇÃO:\n${recipeData.explanation}\n\n`;
            text += `INGREDIENTES:\n`;
            recipeData.ingredients.forEach(ing => { text += `- ${ing}\n`; });
            text += `\nMODO DE PREPARO:\n`;
            recipeData.steps.forEach((step, index) => { text += `${index + 1}. ${step}\n`; });
            if (recipeData.macros) {
                text += `\nMACRONUTRIENTES (Estimativa):\n`;
                text += `  Proteínas: ${recipeData.macros.Proteínas}%\n`;
                text += `  Carboidratos: ${recipeData.macros.Carboidratos}%\n`;
                text += `  Gorduras: ${recipeData.macros.Gorduras}%\n`;
            }
            text += `\n--------------------------------------------------\n\n`;
            return text;
        }

        function generateEbookContent() {
            let ebookText = "MEU EBOOK DE RECEITAS FITNESS\n\n";
            ebookText += "Este ebook foi gerado a partir do aplicativo interativo de Receitas Fitness.\n";
            ebookText += "==================================================\n\n";

            const sortedRecipeKeys = Object.keys(contentData.receitas).sort((a,b) => {
                const catA = contentData.receitas[a].categoryName.toUpperCase();
                const catB = contentData.receitas[b].categoryName.toUpperCase();
                if (catA < catB) return -1;
                if (catA > catB) return 1;
                return contentData.receitas[a].title.localeCompare(contentData.receitas[b].title);
            });

            sortedRecipeKeys.forEach(key => {
                 if (contentData.receitas[key].title && contentData.receitas[key].categoryName) {
                    ebookText += formatRecipeForEbook(contentData.receitas[key]);
                }
            });
            return ebookText;
        }

        saveEbookButton.addEventListener('click', () => {
            const ebookContent = generateEbookContent();
            const blob = new Blob([ebookContent], { type: 'text/plain;charset=utf-8' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'Ebook_Receitas_Fitness_Detalhado.txt';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(link.href);
        });

        function renderRecipeList(categoryKey) {
            contentArea.innerHTML = '';
            const recipesInCategory = Object.values(contentData.receitas).filter(recipe => recipe.categoryKey === categoryKey);
            
            if (recipesInCategory.length === 0) {
                contentArea.innerHTML = `<p class="text-center text-stone-500">Nenhuma receita encontrada para esta categoria.</p>`;
                return;
            }

            const categoryName = recipesInCategory[0].categoryName;
            const titleHtml = `<h2 class="text-3xl font-bold text-emerald-600 mb-6 text-center">${categoryName}</h2>`;
            
            const recipeListContainer = document.createElement('div');
            recipeListContainer.className = "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6";

            recipesInCategory.sort((a,b) => a.title.localeCompare(b.title)).forEach(recipe => {
                const card = document.createElement('div');
                card.className = "recipe-card bg-stone-50 p-5 rounded-xl border border-stone-200 shadow-sm cursor-pointer hover:shadow-md flex flex-col justify-between";
                card.dataset.recipeId = recipe.id;
                card.innerHTML = `
                    <div>
                        <div class="text-5xl mb-3 text-center">${recipe.imagePlaceholder || '🍽️'}</div>
                        <h3 class="text-xl font-semibold text-emerald-500 mb-2 text-center">${recipe.title}</h3>
                        <p class="text-sm text-stone-500 text-center line-clamp-3">${recipe.explanation.substring(0,100)}...</p>
                    </div>
                    <button class="mt-4 w-full bg-emerald-500 hover:bg-emerald-600 text-white text-sm py-2 px-3 rounded-lg view-recipe-button">Ver Receita</button>
                `;
                card.querySelector('.view-recipe-button').addEventListener('click', (e) => {
                    e.stopPropagation(); // Impede que o clique no botão propague para o card
                    renderContent(recipe.id, true); 
                    navButtons.forEach(btn => btn.classList.remove('active'));
                    document.querySelector(`.category-nav-button[data-category-key="${categoryKey}"]`).classList.add('active');
                });
                 card.addEventListener('click', () => { // Adiciona listener ao card também, caso o usuário clique fora do botão
                    renderContent(recipe.id, true); 
                    navButtons.forEach(btn => btn.classList.remove('active'));
                    document.querySelector(`.category-nav-button[data-category-key="${categoryKey}"]`).classList.add('active');
                });
                recipeListContainer.appendChild(card);
            });
            contentArea.innerHTML = titleHtml;
            contentArea.appendChild(recipeListContainer);
        }


        function renderContent(keyOrId, isRecipe = false) {
            contentArea.innerHTML = ''; 
            contentArea.classList.remove('fade-in');
            void contentArea.offsetWidth; 
            contentArea.classList.add('fade-in');

            if (currentChart) {
                currentChart.destroy();
                currentChart = null;
            }

            if (keyOrId === 'intro') {
                contentArea.innerHTML = contentData.intro.content;
                return;
            }

            if (isRecipe) { 
                const data = contentData.receitas[keyOrId];
                if (!data) {
                    contentArea.innerHTML = "<p class='text-center text-red-500'>Receita não encontrada.</p>";
                    return;
                }

                const backButtonHtml = `<button id="back-to-category" data-category="${data.categoryKey}" class="mb-6 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-emerald-700 bg-emerald-100 hover:bg-emerald-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                    Voltar para ${data.categoryName}
                </button>`;
                
                const gridContainer = document.createElement('div');
                gridContainer.className = "grid grid-cols-1 lg:grid-cols-2 gap-8 items-start";
                
                const textContent = document.createElement('div');
                const explanationHtml = `<h3 class="text-3xl font-bold text-emerald-500 mb-3">${data.title}</h3><p class="text-stone-600 mb-6 text-base">${data.explanation}</p>`;
                const ingredientsHtml = `<h4 class="font-semibold text-xl text-stone-700 mb-2">Ingredientes</h4><ul class="list-disc list-inside text-stone-600 space-y-1 mb-6 text-base">${data.ingredients.map(item => `<li>${item}</li>`).join('')}</ul>`;
                const stepsHtml = `<h4 class="font-semibold text-xl text-stone-700 mb-2">Modo de Preparo</h4><ol class="list-decimal list-inside text-stone-600 space-y-2 text-base">${data.steps.map(item => `<li>${item}</li>`).join('')}</ol>`;
                textContent.innerHTML = explanationHtml + ingredientsHtml + stepsHtml;

                const chartContainerWrapper = document.createElement('div');
                chartContainerWrapper.className = "w-full lg:sticky lg:top-20"; 
                
                const chartBox = document.createElement('div');
                chartBox.className = "bg-stone-100 rounded-xl p-4 border border-stone-200";
                chartBox.innerHTML = `
                    <h4 class="font-semibold text-lg text-stone-700 mb-2 text-center">Distribuição de Macronutrientes (Estimativa)</h4>
                    <div class="chart-container relative h-64 md:h-72 w-full max-w-xs mx-auto">
                        <canvas id="macroChart"></canvas>
                    </div>
                `;
                chartContainerWrapper.appendChild(chartBox);
                
                contentArea.innerHTML = backButtonHtml;
                gridContainer.appendChild(textContent);
                if (data.macros) {
                    gridContainer.appendChild(chartContainerWrapper);
                }
                contentArea.appendChild(gridContainer);
                
                if (data.macros) {
                    renderChart(data.macros);
                }

                document.getElementById('back-to-category').addEventListener('click', function() {
                    const categoryKeyToReturn = this.dataset.category;
                    renderContent(categoryKeyToReturn, false);
                    navButtons.forEach(btn => btn.classList.remove('active'));
                    document.querySelector(`.category-nav-button[data-category-key="${categoryKeyToReturn}"]`).classList.add('active');
                });

            } else { 
                renderRecipeList(keyOrId);
            }
        }

        function renderChart(macros) {
            if (currentChart) {
                currentChart.destroy();
            }
            const ctx = document.getElementById('macroChart').getContext('2d');
            currentChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(macros),
                    datasets: [{
                        data: Object.values(macros),
                        backgroundColor: ['#34D399', '#FBBF24', '#F87171'], 
                        borderColor: '#FFFFFF',
                        borderWidth: 3,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { padding: 15, font: { size: 12, family: 'Inter' } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.label || '';
                                    if (label) { label += ': '; }
                                    if (context.parsed !== null) { label += context.parsed + '%'; }
                                    return label;
                                }
                            },
                            padding: 8,
                            titleFont: { size: 14, family: 'Inter' }, bodyFont: { size: 12, family: 'Inter' },
                            backgroundColor: '#334155', titleColor: '#FFFFFF', bodyColor: '#FFFFFF',
                            borderColor: '#475569', borderWidth: 1
                        }
                    }
                }
            });
        }
        
        navButtons.forEach(button => {
            button.addEventListener('click', () => {
                navButtons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');
                
                const categoryKey = button.dataset.categoryKey;
                if (categoryKey) {
                    renderContent(categoryKey, false); 
                } else if (button.id === 'nav-intro') {
                    renderContent('intro');
                }
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            renderContent('intro');
        });

    </script>
</body>
</html>
