                    ],
                    macros: { "Proteínas": 10, "Carboidratos": 75, "Gorduras": 15 },
                    imagePlaceholder: "🍓"
                },
                bebida_cafe_gelado_proteico: {
                    id: 'bebida_cafe_gelado_proteico', categoryKey: 'bebida', categoryName: "Bebida Proteica", title: 'Café Gelado Proteico (Mocha ou Baunilha)',
                    explanation: 'Uma forma deliciosa e prática de consumir sua dose de proteína e cafeína, ideal para começar o dia, como pré-treino ou um lanche energético.',
                    ingredients: ["1 xícara (240ml) de café forte coado e já frio (ou espresso duplo)", "1 scoop (aproximadamente 30g) de whey protein sabor baunilha, chocolate ou café", "Cubos de gelo a gosto", "Opcional: 50-100ml de leite vegetal sem açúcar (amêndoas, coco, aveia) para mais cremosidade, adoçante a gosto (se o whey não for doce o suficiente), cacau em pó ou canela para polvilhar"],
                    steps: [
                        "Prepare o café forte e deixe esfriar completamente. Você pode prepará-lo com antecedência e guardar na geladeira.",
